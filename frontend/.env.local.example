# Supabase — copy from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose this key in the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AES-256 key for portal password encryption (32 bytes, base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=your-32-byte-base64-key
ADMIN_2FA_COOKIE_SECRET=replace-with-a-long-random-string

# Existing nodemailer config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
RECIPIENT_EMAIL=recipient@email.com

# Invoice email delivery
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=billing@yourdomain.com

# Production monitoring
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SITE_URL=https://overdrivepermits.com

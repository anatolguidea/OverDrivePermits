# Supabase — copy from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose this key in the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AES-256 key for portal password encryption (32 bytes, base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=your-32-byte-base64-key

# Existing nodemailer config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
RECIPIENT_EMAIL=recipient@email.com
